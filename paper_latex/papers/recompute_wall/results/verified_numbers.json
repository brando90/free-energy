{
 "_sources": {
  "ci_policy_fig3_fig4": "wlo/whi = program-cluster bootstrap 95% (cluster_boot95, n_boot=1000, cluster = program family) because cells pool 9 (open) / 9 (haiku r8) rollouts per program; Wilson95 fallback where the bootstrap is degenerate (zero between-program variance at ceiling cells). fig2 remains Wilson95: one completion per program per cell, no nesting.",
  "deference": "e11_run/results/E11_<m>/summary_tables.json cells.k1_{bare,full,partial}.absorbed; haiku from E11_haiku_r8 (registered R=8 run)",
  "depth": "e11_run/results/E11_llama8b|E11_qwen7b/summary_tables.json cells.k{0,1,2,3,5}_bare.absorbed; haiku from e11_run/results/E11_haiku_r8/summary_tables.json (registered R=8+greedy run, n=540/cell; supersedes the R=3 pilot E11_haiku)",
  "e13": "e13/results/{E13_haiku,E13_open_llama8b,E13_open_qwen7b}/summary_tables.json cells.{line_k0,k1_deference,grid_kr1}.all \u2014 matched controls cited in Secs 4-5 and the appendix; pooled greedy+sampled rollouts, program-cluster bootstrap CIs",
  "e13_bridge": "e13/results/E13_bridge/summary_attribution.json models.<m>.'<arm>|<cell>'.absorbed \u2014 E13c attribution arms (baseline/self/other_model/human framings over byte-identical perturbed traces), bridge presentation, greedy, one continuation per program (n=60=program_n) so Wilson95 CIs; cited in Sec 5, Sec 9, and app:attribution",
  "e13_tentative_probe": "e13/results/{E13_haiku,E13_open_llama8b,E13_open_qwen7b}/summary_tables.json cells.k1_deference.all.{k1_tentative.absorbed, k1_probe.probe_answer_anywhere_rate/probe_planted_echo_rate} \u2014 tentative '(unverified)' tag + direct-probe cells; probe reported as answer-anywhere (first-integer metric is a restating artifact, disclosed in appendix); cited in Sec 5 and the matched-controls appendix paragraph",
  "fig1_computed_example": "results/EXPH2_FRONTIER_FOLLOWUPS/regime2 program kc1_507786_00300000 + e10_api_bridge/raw_pert_claude-haiku-4-5 continuation",
  "fig1_readable_example": "results/EXPH2_FRONTIER_FOLLOWUPS/regime2 program kr1_507786_00100000 + raw_pert_claude-haiku-4-5 continuation",
  "fig4_inset_lines": "e11_run/results/E11_llama8b/manifest.jsonl real injected_trace_line (bare/full/partial) at k=1",
  "readable_and_computed_claude": "e10_topup_fable/topup_analysis.json job1_pooled[model].cells.{adjacent_contradiction,onehop_kc1}.pooled (batch1+batch2)",
  "readable_and_computed_gpt": "e10_api_bridge/bridge_analysis.json models[model].cells.{adjacent_contradiction,onehop_kc1}.absorbed",
  "readable_and_computed_open": "e10_widen/results_skampere1/EXPG_PROGTRACE_<m>/summary_tables.json cells.{adjacent_contradiction,onehop_kc1}.final_output_absorbed"
 },
